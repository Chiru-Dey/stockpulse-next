# TiDB Cloud Starter connection — values come from the Connect dialog in TiDB Cloud.
# TLS is enforced in code (src/lib/db/client.ts); Node.js trusts the CA automatically.
DATABASE_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DATABASE_PORT=4000
# Must include your instance prefix, e.g. 2AbCdEfGhIj.root
DATABASE_USER=YOUR_PREFIX.root
# Generated password (shown once). Keep it single-quoted: it contains special characters.
DATABASE_PASSWORD=''
DATABASE_NAME=stockpulse

# Credentials for the demo accounts created by scripts/seed.ts.
# These are example values — choose your own before running the seed.
SEED_ADMIN_PASSWORD='Admin-Demo-9271'
SEED_STAFF_PASSWORD='Staff-Demo-4482'

# HS256 signing secret for access JWTs — minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-with-a-random-64-char-string